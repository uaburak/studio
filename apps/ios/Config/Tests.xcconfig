// StudioTests: unit tests (Swift Testing), hosted in Studio.app.

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = net.burakkoc.studio.tests
GENERATE_INFOPLIST_FILE = YES
TEST_HOST = $(BUILT_PRODUCTS_DIR)/Studio.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/Studio
BUNDLE_LOADER = $(TEST_HOST)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
