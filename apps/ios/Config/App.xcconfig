// Studio.app

PRODUCT_NAME = Studio
PRODUCT_MODULE_NAME = Studio
// Placeholder until the App ID is registered with an Apple Developer account.
PRODUCT_BUNDLE_IDENTIFIER = net.burakkoc.studio

GENERATE_INFOPLIST_FILE = YES
// Keys that build settings cannot express (ATS, localizations) live here and are merged.
INFOPLIST_FILE = Config/Studio-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Studio
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Studio, yerel ağdaki geliştirme sunucusuna (Mac) bağlanmak için yerel ağ erişimi ister.

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
