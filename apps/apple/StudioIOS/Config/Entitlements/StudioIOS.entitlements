<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- STUDIO_SHARING = YES: App Group + shared Keychain group (the app's own group stays first, so
     items written before keep their place). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(STUDIO_BUNDLE_ID)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(STUDIO_BUNDLE_ID)</string>
		<string>$(AppIdentifierPrefix)$(STUDIO_BUNDLE_ID).shared</string>
	</array>
</dict>
</plist>
