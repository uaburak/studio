// Project-level settings shared by every target (Debug and Release) for StudioIOS.

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 26.0
// iPhone only (M9): the iPad has no layout of its own.
TARGETED_DEVICE_FAMILY = 1

// Swift 6 language mode: complete strict concurrency checking.
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES

// The app's bundle id: the one place it is set for iOS (Info.plist and the code derive from
// it). Override it in Config/Local.xcconfig for your own Apple team. The extensions are
// $(STUDIO_BUNDLE_ID).share and $(STUDIO_BUNDLE_ID).widget; the App Group is
// group.$(STUDIO_BUNDLE_ID); the shared Keychain group $(AppIdentifierPrefix)$(STUDIO_BUNDLE_ID).shared.
STUDIO_BUNDLE_ID = net.burakkoc.studio.ios

// What the app shares with its share extension and widget (apps/apple/README.md):
//   YES      App Group + shared Keychain group (a paid team with both identifiers registered)
//   KEYCHAIN shared Keychain group only (a free personal team; the wildcard-profile install)
//   NO       neither (the extensions then ask to open Studio)
// Override it in Config/Local.xcconfig. Simulator builds are unsigned and ignore it.
STUDIO_SHARING = YES

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Simulator builds sign ad hoc / without provisioning profile. The Apple team id is never
// committed: put DEVELOPMENT_TEAM in Config/Local.xcconfig (gitignored, see Local.xcconfig.example).
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
CODE_SIGNING_ALLOWED[sdk=iphonesimulator*] = NO
CODE_SIGNING_REQUIRED[sdk=iphonesimulator*] = NO

ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_NO_COMMON_BLOCKS = YES
COPY_PHASE_STRIP = NO
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO

DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf
DEBUG_INFORMATION_FORMAT[config=Release] = dwarf-with-dsym
ONLY_ACTIVE_ARCH[config=Debug] = YES
ENABLE_TESTABILITY[config=Debug] = YES
GCC_OPTIMIZATION_LEVEL[config=Debug] = 0
GCC_PREPROCESSOR_DEFINITIONS[config=Debug] = DEBUG=1 $(inherited)
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG $(inherited)
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone
SWIFT_OPTIMIZATION_LEVEL[config=Release] = -O
SWIFT_COMPILATION_MODE[config=Release] = wholemodule
ENABLE_NS_ASSERTIONS[config=Release] = NO

// Per-developer settings (team id, signing, bundle id); optional and gitignored.
#include? "Local.xcconfig"
