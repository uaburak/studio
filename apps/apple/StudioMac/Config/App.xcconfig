// Studio.app (macOS)

PRODUCT_NAME = Studio
PRODUCT_MODULE_NAME = StudioMac
// Placeholder until the App ID is registered with an Apple Developer account.
PRODUCT_BUNDLE_IDENTIFIER = net.burakkoc.studio.mac

GENERATE_INFOPLIST_FILE = YES
// Keys build settings cannot express (ATS local networking, localizations).
INFOPLIST_FILE = Config/StudioMac-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Studio
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSHumanReadableCopyright = Burak Koç

// Not sandboxed yet: the app talks to a local dev server and is not distributed.
// Turn on (with com.apple.security.network.client and user-selected files) before shipping.
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = NO

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ENABLE_PREVIEWS = YES
COMBINE_HIDPI_IMAGES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
