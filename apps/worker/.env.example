# Studio Mac worker — environment variables.
# Copy to apps/worker/.env for local overrides (that file is git-ignored).
# Defaults are shown; only STUDIO_WORKER_TOKEN is required.

# Hub WebSocket URL (the API's /api/hub route). Local `pnpm dev` serves it here.
STUDIO_HUB_URL=ws://127.0.0.1:8787/api/hub

# REQUIRED. Shared secret sent as `Authorization: Bearer <token>` to the hub.
# Must equal WORKER_TOKEN in apps/api/.dev.vars (local) or the deployed secret.
# Never commit a real value. Generate one with: openssl rand -hex 32
STUDIO_WORKER_TOKEN=change-me-local-dev-token

# Stable identifier of this machine in the hub. Defaults to the hostname.
# STUDIO_WORKER_ID=burak-macbook

# Jobs run at the same time (1..16). The hub never sends more than this.
STUDIO_CONCURRENCY=1

# Seconds between lease heartbeats for running jobs (hub lease is 60 s).
STUDIO_HEARTBEAT_INTERVAL_S=15

# Graceful shutdown (SIGINT/SIGTERM): seconds to wait for running jobs to stop
# and be handed back, and for unsent results to reach the hub.
STUDIO_SHUTDOWN_TIMEOUT_S=10

# Where finished-but-unacknowledged results are kept between runs.
# Default: ~/.studio/worker
# STUDIO_STATE_DIR=/Users/you/.studio/worker

# Reconnect backoff: first delay, ceiling, and jitter ratio (0..1).
STUDIO_RECONNECT_BASE_MS=500
STUDIO_RECONNECT_MAX_MS=30000
STUDIO_RECONNECT_JITTER=0.2

# Seconds between keepalive pings sent to the hub.
STUDIO_PING_INTERVAL_S=25

# debug | info | warn | error
STUDIO_LOG_LEVEL=info
