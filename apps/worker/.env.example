# Studio Mac worker — environment variables.
# Copy to apps/worker/.env for local overrides (that file is git-ignored).
# Defaults are shown; only STUDIO_WORKER_TOKEN is required.

# Hub WebSocket URL (the API's /api/hub route). Local `pnpm dev` serves it here.
STUDIO_HUB_URL=ws://127.0.0.1:8787/api/hub

# REQUIRED. Shared secret sent as `Authorization: Bearer <token>` to the hub.
# Must equal WORKER_TOKEN in apps/api/.dev.vars (local) or the deployed secret.
# Never commit a real value. Generate one with: openssl rand -hex 32
STUDIO_WORKER_TOKEN=change-me-local-dev-token

# Stable identifier of this machine in the hub. Defaults to the hostname.
# STUDIO_WORKER_ID=deniz-macbook

# Jobs run at the same time (1..16). The hub never sends more than this.
STUDIO_CONCURRENCY=1

# Seconds between lease heartbeats for running jobs (hub lease is 60 s).
STUDIO_HEARTBEAT_INTERVAL_S=15

# Graceful shutdown (SIGINT/SIGTERM): seconds to wait for running jobs to stop
# and be handed back, and for unsent results to reach the hub.
STUDIO_SHUTDOWN_TIMEOUT_S=10

# Where finished-but-unacknowledged results are kept between runs.
# Default: ~/.studio/worker
# STUDIO_STATE_DIR=/Users/you/.studio/worker

# Reconnect backoff: first delay, ceiling, and jitter ratio (0..1).
STUDIO_RECONNECT_BASE_MS=500
STUDIO_RECONNECT_MAX_MS=30000
STUDIO_RECONNECT_JITTER=0.2

# Seconds between keepalive pings sent to the hub.
STUDIO_PING_INTERVAL_S=25

# debug | info | warn | error
STUDIO_LOG_LEVEL=info

# ---- Headless Claude (chat.turn, content.generate) -------------------------------
# The worker spawns the `claude` CLI on the owner's subscription (log in once with
# `claude auth login` or from Settings in the app). The child gets an allow-listed
# environment only; never set ANTHROPIC_API_KEY for the worker.
# STUDIO_CLAUDE_ENABLED=1            # 0 = only demo.echo (smoke tests)
# STUDIO_API_URL=                    # default: derived from STUDIO_HUB_URL
# STUDIO_CLAUDE_BIN=claude
# STUDIO_CLAUDE_MODEL=opus           # default when a run/job names no model (opus|sonnet|haiku)
# STUDIO_CLAUDE_EFFORT_CHAT=         # default when a run names no effort: medium
# STUDIO_CLAUDE_EFFORT_DESIGN=       # default when a job names no effort: medium
# STUDIO_CLAUDE_CONCURRENCY=1        # Claude calls at the same time (all jobs)
# STUDIO_CLAUDE_TIMEOUT_S=900        # per call
# STUDIO_CLAUDE_CONFIG_DIR=          # separate login: CLAUDE_CONFIG_DIR=<dir> claude auth login
# STUDIO_CLAUDE_SELFTEST=auto        # auto: tiny test call at most every 6 h | always | never
# STUDIO_CLAUDE_LOG_STREAMS=0        # 1 = raw stream-json of every call in <state>/claude-logs
# STUDIO_USAGE_LIMIT_FALLBACK_MIN=30 # wait when a usage limit names no reset time
# STUDIO_CHAT_MAX_IMAGES=4           # images of the latest message shown to the chat agent
# STUDIO_IMAGE_MAX_EDGE=1568         # long edge of images sent to the model
# STUDIO_DESIGN_FIX_PASSES=1         # extra passes when lint errors remain after critique+revise

# ---- Gemini Chat & Image Provider ------------------------------------------------
# Direct Gemini API via GEMINI_API_KEY and/or local `gemini` CLI.
# Prefer entering the key in the desktop app (Ayarlar → Yapay zekâ): it is sealed in the
# API's vault and the worker uses it before this variable, which stays as the fallback.
# GEMINI_API_KEY=                    # Google AI Studio key (used directly via REST API)
# STUDIO_GEMINI_MODE=auto            # auto | api | cli
# STUDIO_GEMINI_BIN=gemini
# Model per alias; unset = the newest priced model of that tier the stored key lists, else
# gemini-2.5-flash-lite / gemini-2.5-flash / gemini-2.5-pro. A value set here always wins.
# STUDIO_GEMINI_MODEL_FLASH_LITE=
# STUDIO_GEMINI_MODEL_FLASH=
# STUDIO_GEMINI_MODEL_PRO=
# STUDIO_GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Other providers (Ayarlar → Yapay zekâ). Codex CLI and Antigravity CLI use their own sign-in;
# the OpenAI API key is entered in the app (vault only, no .env variable).
# STUDIO_CODEX_BIN=codex             # `npm i -g --prefix ~/.local @openai/codex`
# STUDIO_CODEX_MODEL=                # `codex exec -m`; unset = the CLI's default model
# STUDIO_OPENAI_MODEL=               # Responses API model; unset = the key's best listed chat model
# STUDIO_ANTIGRAVITY_BIN=agy
# STUDIO_ANTIGRAVITY_MODEL=          # `agy models` slug; unset = the CLI's default

# ---- Reels Video, TTS & Transcription -------------------------------------------
# ELEVENLABS_API_KEY=                # Optional ElevenLabs key for word-aligned voiceovers
# STUDIO_ELEVENLABS_VOICE_ID=        # Unset = a voice of the text's language from your account
#                                    # (Turkish text needs a Turkish voice from the Voice Library)
# STUDIO_FFMPEG_BIN=                 # Optional explicit path to ffmpeg
# STUDIO_WHISPER_BIN=                # Optional explicit path to whisper-cli

# ---- Cloud Publisher & Schedule Sync --------------------------------------------
# STUDIO_CLOUD_PUBLISHER_URL=        # Optional Cloud Publisher base URL (e.g. https://pub.example.com)
# STUDIO_CLOUD_PUBLISHER_TOKEN=      # Shared bearer token for Cloud Publisher
# STUDIO_SCHEDULE_POLL_INTERVAL_S=30 # Seconds between due-schedule checks (0 disables)
