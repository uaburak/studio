{
  "name": "@studio/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --sourcemap --external:sharp --external:playwright-core --outfile=dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "e2e": "tsx scripts/e2e.ts",
    "selftest": "tsx --env-file-if-exists=.env scripts/selftest.ts",
    "code-engine:setup": "tsx --env-file-if-exists=.env scripts/setup-code-engine.ts",
    "tools:e2e": "tsx scripts/tools-e2e.ts"
  },
  "dependencies": {
    "@studio/contract": "workspace:*",
    "@studio/design-kit": "workspace:*",
    "parse5": "8.0.1",
    "playwright-core": "1.65.1",
    "sharp": "0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
