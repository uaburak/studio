// Studio API — Cloudflare Worker (Hono) + Hub Durable Object.
//
// LOCAL ONLY for now. Nothing here has been created on Cloudflare:
// - the D1 database_id is a placeholder (deploy task will create the real one),
// - the R2 bucket does not exist remotely,
// - do not run `wrangler deploy` / `wrangler login` from this skeleton.
// `wrangler dev` and the Vitest plugin simulate all bindings locally (.wrangler/state).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "observability": { "enabled": true },
  // Do not send Wrangler usage telemetry from this project.
  "send_metrics": false,

  "vars": {
    // Enables /api/dev/* routes (demo job trigger). Must be "production" when deployed.
    "ENVIRONMENT": "development"
  },

  // Shared secret the Mac worker presents on /api/hub (Authorization: Bearer).
  // Locally: copy .dev.vars.example to .dev.vars. Deployed: `wrangler secret put
  // WORKER_TOKEN` (deploy task). Declaring it here also fixes the generated Env
  // type, independent of whether a .dev.vars file exists.
  "secrets": { "required": ["WORKER_TOKEN"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studio",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "studio-media"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },

  // Declarative Durable Object provisioning (replaces legacy "migrations").
  "exports": {
    "Hub": { "type": "durable-object", "storage": "sqlite" }
  }
}
