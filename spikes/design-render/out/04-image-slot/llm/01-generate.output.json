      "html": "<!doctype html>\n<html lang=\"tr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"studio:contract\" content=\"v0\">\n  <meta name=\"studio:format\" content=\"1080x1350\">\n  <link rel=\"stylesheet\" href=\"/brand/brand.css\">\n  <style>\n    main[data-artboard] { position: relative; background: var(--color-paper); }\n\n    /* Field photo: one full-bleed 4:3 slot, top 60% of the post */\n    .field-photo { margin: 0; }\n\n    /* Pack label edge: green band closes the photo */\n    .label-band { background: var(--color-green); }\n\n    /* Copy stack on paper, below the band */\n    .copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-32); }\n    .statement { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-16); }\n    .shout {\n      font-family: var(--font-display); font-size: 88px; font-weight: 900; font-stretch: 125%;\n      font-style: italic; text-transform: uppercase; letter-spacing: -0.01em; line-height: 1.04;\n      color: var(--color-ink); text-wrap: balance; hyphens: none;\n    }\n    .subhead {\n      font-family: var(--font-text); font-size: 40px; font-weight: 700; line-height: 1.2;\n      letter-spacing: -0.01em; color: var(--color-ink); max-width: 616px; text-wrap: balance; hyphens: none;\n    }\n    .subhead .product { color: var(--color-green-deep); }\n    .note {\n      font-family: var(--font-text); font-size: 30px; font-weight: 500; line-height: 1.38;\n      color: var(--color-graphite); max-width: 616px; hyphens: none;\n    }\n\n    /* Element badges (regular flat-top hexagons) */\n    .badge { display: grid; }\n    .badge > * { grid-area: 1 / 1; }\n    .hex { width: 120px; height: 104px; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); }\n    .hex-b { background: var(--color-amber); }\n    .hex-zn { background: var(--color-green); }\n    .hex-label {\n      align-self: center; justify-self: center;\n      font-family: var(--font-text); font-size: 48px; font-weight: 700; line-height: 1;\n      color: var(--color-ink);\n    }\n\n    /* Sign-off: logo left, web address right */\n    .sign-off { display: flex; align-items: center; justify-content: space-between; }\n    .logo { height: 40px; width: auto; flex: none; }\n    .url {\n      font-family: var(--font-text); font-size: 24px; font-weight: 500; line-height: 1.3;\n      letter-spacing: 0.04em; color: var(--color-graphite);\n    }\n  </style>\n</head>\n<body>\n  <main data-artboard style=\"width:1080px;height:1350px\">\n\n    <figure data-layer=\"field-photo\" data-type=\"slot\" data-slot-ratio=\"4:3\" data-slot-state=\"empty\"\n            data-slot-label=\"Saha fotoğrafı\" data-slot-fit=\"cover\" class=\"field-photo\"\n            style=\"position:absolute; left:0px; top:0px; width:1080px; height:810px\"></figure>\n\n    <div data-layer=\"label-band\" data-type=\"shape\" data-role=\"decoration\" class=\"label-band\"\n         style=\"position:absolute; left:0px; top:810px; width:1080px; height:16px\"></div>\n\n    <div data-layer=\"copy\" data-type=\"group\" class=\"copy\"\n         style=\"position:absolute; left:72px; top:920px; width:936px\">\n      <div data-layer=\"statement\" data-type=\"group\" class=\"statement\">\n        <h1 data-layer=\"headline\" data-type=\"text\" data-role=\"headline\" class=\"ts-display-m shout\">Bor ve çinko</h1>\n        <p data-layer=\"subhead\" data-type=\"text\" data-role=\"subhead\" class=\"ts-title subhead\"><span class=\"product\">Venta Borinc</span> ile bir arada.</p>\n      </div>\n      <p data-layer=\"label-note\" data-type=\"text\" data-role=\"body\" class=\"ts-body note\">Kullanmadan önce etiketi okuyunuz.</p>\n    </div>\n\n    <div data-layer=\"badge-b\" data-type=\"group\" data-role=\"badge\" class=\"badge\"\n         style=\"position:absolute; left:752px; top:1036px; width:120px; height:104px\">\n      <div data-layer=\"badge-b-hex\" data-type=\"shape\" data-role=\"decoration\" class=\"hex hex-b\"></div>\n      <p data-layer=\"badge-b-label\" data-type=\"text\" data-role=\"badge\" class=\"hex-label\">B</p>\n    </div>\n\n    <div data-layer=\"badge-zn\" data-type=\"group\" data-role=\"badge\" class=\"badge\"\n         style=\"position:absolute; left:888px; top:1036px; width:120px; height:104px\">\n      <div data-layer=\"badge-zn-hex\" data-type=\"shape\" data-role=\"decoration\" class=\"hex hex-zn\"></div>\n      <p data-layer=\"badge-zn-label\" data-type=\"text\" data-role=\"badge\" class=\"hex-label\">Zn</p>\n    </div>\n\n    <div data-layer=\"sign-off\" data-type=\"group\" class=\"sign-off\"\n         style=\"position:absolute; left:72px; top:1238px; width:936px; height:40px\">\n      <img data-layer=\"logo-venta\" data-type=\"logo\" class=\"logo\"\n           src=\"/brand/logos/venta-wordmark-black.standin.png\" alt=\"Venta\">\n      <p data-layer=\"web-address\" data-type=\"text\" data-role=\"caption\" class=\"ts-caption url\">www.mtmagro.com</p>\n    </div>\n\n  </main>\n</body>\n</html>\n"
    }
