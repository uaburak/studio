{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Isomorphic sources: Web platform + DOM types only. No @types/node, so any
    // Node-only API (Buffer, process, node:*) fails this typecheck. The renderer
    // (src/render) and the tests are checked by tsconfig.node.json.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/render"]
}
