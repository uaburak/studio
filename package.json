{
  "name": "studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @studio/desktop run dev",
    "dev:worker": "pnpm --filter @studio/worker run dev",
    "typecheck": "STUDIO_WECRA_OPTIONAL=1 pnpm -r run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "STUDIO_WECRA_OPTIONAL=1 pnpm -r run test",
    "build": "STUDIO_WECRA_OPTIONAL=1 pnpm -r run build"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:"
  }
}
